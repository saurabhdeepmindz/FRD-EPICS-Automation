// Prisma schema for PRD Generator
// Provider: postgresql
// Run: npx prisma db push  (dev)
//      npx prisma migrate dev --name <name>  (migration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PrdStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  BASELINED
}

enum SectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

// ─── PRD document (one row per PRD) ──────────────────────────────────────────

model Prd {
  id          String    @id @default(cuid())
  prdCode     String    @unique         // e.g. PRD-LSM001
  productName String
  version     String    @default("1.0")
  status      PrdStatus @default(DRAFT)
  author      String?
  clientName  String?
  submittedBy String?
  clientLogo  String?           // base64 data-URI or file path
  sourceText  String?   @db.Text  // original input text used to generate PRD
  sourceFileName String?          // original uploaded file name (if any)
  sourceFileData String? @db.Text // original file stored as base64 (Phase 1: local DB, Phase 2: S3 URL)
  reviewedBy  String?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections    PrdSection[]
  auditLogs   PrdAuditLog[]

  @@map("prds")
}

// ─── PRD section (one row per section per PRD) ────────────────────────────────

model PrdSection {
  id            String        @id @default(cuid())
  prdId         String
  sectionNumber Int           // 1–22
  sectionName   String
  status        SectionStatus @default(NOT_STARTED)
  content       Json          @default("{}")  // flexible JSON per section schema
  aiSuggested   Boolean       @default(false) // true if any field was AI-filled
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  prd           Prd           @relation(fields: [prdId], references: [id], onDelete: Cascade)

  @@unique([prdId, sectionNumber])
  @@map("prd_sections")
}

// ─── Audit trail (one row per field change) ───────────────────────────────

enum ChangeType {
  CREATED
  MODIFIED
  AI_GENERATED
  AI_MODIFIED
}

enum ChangeSource {
  AI
  MANUAL
}

model PrdAuditLog {
  id            String       @id @default(cuid())
  prdId         String
  sectionNumber Int
  fieldKey      String       // e.g. "productName", "6.1_features[0].description"
  changeType    ChangeType
  source        ChangeSource
  previousValue String?      @db.Text
  newValue      String?      @db.Text
  version       String       // e.g. "1.0", "1.1"
  createdAt     DateTime     @default(now())

  prd           Prd          @relation(fields: [prdId], references: [id], onDelete: Cascade)

  @@index([prdId, createdAt])
  @@map("prd_audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// BA AUTOMATION TOOL — New models (additive only — existing models untouched)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── BA Project ──────────────────────────────────────────────────────────────

enum BaProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model BaProject {
  id          String          @id @default(uuid())
  name        String
  projectCode String          @unique
  description String?
  productName String?         // Required before EPIC generation
  clientName  String?
  submittedBy String?
  clientLogo  String?         @db.Text   // base64 data-URI for preview cover
  status      BaProjectStatus @default(ACTIVE)
  // Project-wide SQL dialect used by skills that emit SQL (FTC test data,
  // verification scripts). Values: "postgresql" | "mysql" | "sqlserver" |
  // "oracle" | "ansi". Default Postgres matches the app's own DB.
  sqlDialect  String          @default("postgresql")
  // E2E-Flow (Track R) — project-scoped cross-module journeys. Off the module
  // status machine (like LLD/FTC); these are additive + nullable.
  e2eFlowCompletedAt DateTime?
  e2eFlowActiveId    String?    // the BaE2eFlow currently driving downstream elaboration
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  modules     BaModule[]
  rtmRows     BaRtmRow[]
  masterDataEntries BaMasterDataEntry[]
  templates   BaTemplate[]
  sprints     BaSprint[]
  // Discovery & Solutioning Track (Stages 1-5 of phased rollout)
  audioFiles    BaAudioFile[]
  wfts          BaWft[]
  brds          BaBrd[]
  approachNotes BaApproachNote[]
  wireframeSets BaWireframeSet[]
  hifiSets      BaHifiSet[]
  // New Pipeline Track (Stages 1-9)
  customerInputs  BaCustomerInput[]
  projectPrds     BaProjectPrd[]
  screenMaps      BaScreenMap[]
  designSystems   BaDesignSystem[]
  designPresets   BaDesignPreset[]
  hlds            BaHld[]
  implementation  BaProjectImplementation?
  changeRequests  BaChangeRequest[]
  // E2E-Flow (Track R)
  e2eFlows                BaE2eFlow[]
  e2eFlowConfig           BaE2eFlowConfig?
  thirdPartyIntegrations  BaThirdPartyIntegration[]

  @@map("ba_projects")
}

// ─── BA Sprint ───────────────────────────────────────────────────────────────

enum BaSprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

// v4.4 B1 — Real Sprint entity. Replaces free-text `sprintId` strings that
// previously lived on BaTestCase/BaTestRun. Those columns remain for backward
// compat; new code should prefer the `sprintDbId` FK.
model BaSprint {
  id         String         @id @default(uuid())
  projectId  String
  project    BaProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintCode String         // human-readable: "v2.3", "Sprint 23"
  name       String         // "Checkout hardening"
  goal       String?        @db.Text
  startDate  DateTime?
  endDate    DateTime?
  status     BaSprintStatus @default(PLANNING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  testCases  BaTestCase[]
  testRuns   BaTestRun[]

  @@unique([projectId, sprintCode])
  @@index([projectId, status])
  @@map("ba_sprints")
}

// ─── BA Module ───────────────────────────────────────────────────────────────

enum BaModuleStatus {
  DRAFT
  SCREENS_UPLOADED
  ANALYSIS_COMPLETE
  FRD_COMPLETE
  EPICS_COMPLETE
  STORIES_COMPLETE
  SUBTASKS_COMPLETE
  APPROVED
}

model BaModule {
  id              String         @id @default(uuid())
  projectId       String
  project         BaProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId        String         // e.g. MOD-01
  moduleName      String
  packageName     String
  moduleStatus    BaModuleStatus @default(DRAFT)
  processedAt     DateTime?
  approvedAt      DateTime?
  // v4 — LLD completion tracked independently of the existing status machine
  lldCompletedAt  DateTime?
  lldArtifactId   String?
  // v4.2 — FTC (Functional Test Cases) completion, same independence as LLD
  ftcCompletedAt  DateTime?
  ftcArtifactId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  screens          BaScreen[]
  flows            BaClickThroughFlow[]
  skillExecutions  BaSkillExecution[]
  artifacts        BaArtifact[]
  tbdFutureEntries BaTbdFutureEntry[]
  subtasks         BaSubTask[]
  lldConfig        BaLldConfig?
  ftcConfig        BaFtcConfig?
  codeTasks        BaCodeTask[]
  codeTestRuns     BaCodeTestRun[]
  upstreamSyncs    BaUpstreamSync[]

  @@unique([projectId, moduleId])
  @@map("ba_modules")
}

// ─── BA Screen ───────────────────────────────────────────────────────────────

model BaScreen {
  id                  String   @id @default(uuid())
  moduleDbId          String
  module              BaModule @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  screenId            String   // e.g. SCR-01
  screenTitle         String
  screenType          String?  // Dashboard / Form / List / Detail / Modal / Navigation / Other
  fileData            String   @db.Text // base64 image data (Phase 1: DB, Phase 2: S3 URL)
  fileName            String   // original file name
  mimeType            String   // image/png, image/jpeg, etc.
  displayOrder        Int      @default(0)
  textDescription     String?  @db.Text
  audioFileData       String?  @db.Text // base64 audio (Phase 1)
  audioTranscript     String?  @db.Text
  transcriptReviewed  Boolean  @default(false)
  aiFormattedTranscript String? @db.Text  // AI-polished version of transcript
  aiTranscriptReviewed  Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([moduleDbId, screenId])
  @@map("ba_screens")
}

// ─── BA Click-Through Flow ───────────────────────────────────────────────────

model BaClickThroughFlow {
  id          String   @id @default(uuid())
  moduleDbId  String
  module      BaModule @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  flowName    String
  steps       Json     // Array of { screenId, triggerLabel, outcome }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ba_click_through_flows")
}

// ─── BA Skill Execution ──────────────────────────────────────────────────────

enum BaExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  AWAITING_REVIEW
  APPROVED
  FAILED
}

model BaSkillExecution {
  id              String            @id @default(uuid())
  moduleDbId      String
  module          BaModule          @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  skillName       String            // SKILL-00, SKILL-01-S, SKILL-02-S, SKILL-04, SKILL-05
  status          BaExecutionStatus @default(PENDING)
  contextPacket   Json?             // assembled context sent to AI
  rawOutput       String?           @db.Text
  humanDocument   String?           @db.Text  // markdown output
  handoffPacket   Json?             // compressed JSON for next skill
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())

  @@index([moduleDbId, skillName])
  @@map("ba_skill_executions")
}

// ─── BA Artifact ─────────────────────────────────────────────────────────────

enum BaArtifactType {
  SCREEN_ANALYSIS
  FRD
  EPIC
  USER_STORY
  SUBTASK
  PRD
  RTM
  LLD
  FTC
  E2E_FLOW
}

enum BaArtifactStatus {
  DRAFT
  CONFIRMED_PARTIAL
  CONFIRMED
  APPROVED
}

model BaArtifact {
  id           String           @id @default(uuid())
  moduleDbId   String
  module       BaModule         @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  artifactType BaArtifactType
  artifactId   String           // e.g. FRD-MOD-02, EPIC-02, US-013
  status       BaArtifactStatus @default(DRAFT)
  approvedAt   DateTime?
  // Snapshot of architect narrative used to produce this artifact (LLD only).
  // Populated when the LLD was generated via the narrative flow; null for
  // stack-only generations so existing queries are unaffected.
  sourceNarrative String?        @db.Text
  // ── CR Foundation (Track M — traceability fields, nullable, no UI yet) ──
  // What caused this artifact version to be created.
  triggeredBy     BaTriggeredBy? @default(INITIAL_GENERATION)
  // Soft FK to ba_change_requests.id — set when a Change Request produced this version.
  changeRequestId String?
  // Which upstream artifact versions this was generated from, e.g.
  // { "prdVersion": 2, "hldVersion": 1, "frdArtifactId": "..." }.
  sourceArtifactVersions Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sections     BaArtifactSection[]
  subtasks     BaSubTask[]
  pseudoFiles  BaPseudoFile[]
  testCases    BaTestCase[]
  acCoverage   BaAcCoverage[]

  @@index([changeRequestId])
  @@map("ba_artifacts")
}

model BaArtifactSection {
  id              String     @id @default(uuid())
  artifactId      String
  artifact        BaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sectionKey      String     // e.g. "businessContext", "integrationDomains"
  sectionLabel    String     // human-readable label
  aiGenerated     Boolean    @default(true)
  content         String     @db.Text
  editedContent   String?    @db.Text  // human-edited version
  isHumanModified Boolean    @default(false)
  isLocked        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("ba_artifact_sections")
}

// ─── BA TBD-Future Registry ──────────────────────────────────────────────────

model BaTbdFutureEntry {
  id                 String   @id @default(uuid())
  moduleDbId         String
  module             BaModule @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  registryId         String   // e.g. TBD-001
  integrationName    String
  classification     String   // INTERNAL-TBD-Future or EXTERNAL-TBD-Future
  referencedModule   String?  // MOD-XX
  assumedInterface   String   @db.Text
  resolutionTrigger  String
  appearsInFeatures  String[] // Array of Feature IDs
  isResolved         Boolean  @default(false)
  resolvedAt         DateTime?
  resolvedInterface  String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("ba_tbd_future_entries")
}

// ─── BA RTM Row ──────────────────────────────────────────────────────────────

model BaRtmRow {
  id                String    @id @default(uuid())
  projectId         String
  project           BaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId          String    // MOD-XX
  moduleName        String
  packageName       String
  featureId         String
  featureName       String
  featureStatus     String
  priority          String
  screenRef         String
  epicId            String?
  epicName          String?
  storyId           String?
  storyName         String?
  storyType         String?   // Frontend / Backend / Integration
  storyStatus       String?
  primaryClass      String?
  sourceFile        String?
  subtaskId         String?
  subtaskTeam       String?   // FE / BE / IN / QA
  methodName        String?
  testCaseIds       String[]
  integrationStatus String?
  tbdFutureRef      String?
  tbdResolved       Boolean   @default(false)
  // LLD trace — populated after SKILL-06-LLD. Links the RTM row to pseudo-code files
  // derived from SKILL-06 so the trace runs all the way to source.
  lldArtifactId     String?   // ba_artifacts.id of the active LLD bundle
  layer             String?   // Frontend / Backend / Database / Integration / Testing
  pseudoFileIds     String[]  @default([])
  pseudoFilePaths   String[]  @default([])
  // FTC trace — populated after SKILL-07-FTC. testCaseIds already existed for
  // pre-FTC SubTask test-case references; new columns below track the FTC
  // artifact + OWASP coverage per RTM row.
  ftcArtifactId     String?   // ba_artifacts.id of the active FTC bundle
  ftcTestCaseIds    String[]  @default([])  // BaTestCase.id values
  ftcTestCaseRefs   String[]  @default([])  // human-readable TC-001, TC-002-INT-01, ...
  // CR Foundation (Track M) — soft FK to ba_change_requests.id when a CR touched this row.
  changeRequestId   String?
  owaspWebCategories String[] @default([])  // A01, A03, ...
  owaspLlmCategories String[] @default([])  // LLM01, LLM06, ...
  // E2E-Flow (Track R) — which cross-module journeys + steps this row participates in.
  e2eFlowIds        String[]  @default([])  // BaE2eFlow.id values
  e2eFlowStepRefs   String[]  @default([])  // BaE2eFlowStep.stepId values (e.g. S04)
  e2eFlowMappingNotes String?  @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId, moduleId])
  @@map("ba_rtm_rows")
}

// ─── BA SubTask (structured output from SKILL-05) ────────────────────────────

enum SubTaskStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}

model BaSubTask {
  id               String        @id @default(uuid())
  moduleDbId       String
  module           BaModule      @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  artifactDbId     String?
  artifact         BaArtifact?   @relation(fields: [artifactDbId], references: [id])
  subtaskId        String        // e.g. ST-US001-BE-01
  subtaskName      String
  subtaskType      String?       // Code / Config / Test / Documentation / DevOps
  team             String?       // FE / BE / IN / QA
  userStoryId      String?       // e.g. US-001
  epicId           String?       // e.g. EPIC-01
  featureId        String?       // e.g. F-01-01
  moduleId         String?       // e.g. MOD-01
  packageName      String?
  assignedTo       String?
  estimatedEffort  String?       // e.g. "4 hours"
  prerequisites    String[]      // SubTask IDs this depends on
  status           SubTaskStatus @default(DRAFT)
  priority         String?       // P0 / P1 / P2 / P3
  tbdFutureRefs    String[]      // e.g. ["TBD-001"]
  sourceFileName   String?
  className        String?
  methodName       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sections         BaSubTaskSection[]

  @@unique([moduleDbId, subtaskId])
  @@index([moduleDbId])
  @@map("ba_subtasks")
}

model BaSubTaskSection {
  id              String     @id @default(uuid())
  subtaskDbId     String
  subtask         BaSubTask  @relation(fields: [subtaskDbId], references: [id], onDelete: Cascade)
  sectionNumber   Int        // 1-24
  sectionKey      String     // e.g. "algorithm", "integration_points"
  sectionLabel    String     // e.g. "Algorithm", "Integration Points"
  aiContent       String     @db.Text   // original AI output — immutable
  editedContent   String?    @db.Text   // human-edited version
  isHumanModified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([subtaskDbId, sectionNumber])
  @@map("ba_subtask_sections")
}

// ─── v4: Architect Console (Master Data) ─────────────────────────────────────

enum BaMasterDataCategory {
  FRONTEND_STACK
  BACKEND_STACK
  DATABASE
  STREAMING
  CACHING
  STORAGE
  CLOUD
  ARCHITECTURE
  PROJECT_STRUCTURE
  BACKEND_TEMPLATE
  FRONTEND_TEMPLATE
  LLD_TEMPLATE
  FTC_TEMPLATE
  CODING_GUIDELINES
}

enum BaMasterDataScope {
  GLOBAL
  PROJECT
}

enum BaTemplateModifier {
  AI
  HUMAN
}

model BaMasterDataEntry {
  id          String               @id @default(uuid())
  category    BaMasterDataCategory
  scope       BaMasterDataScope    @default(PROJECT)
  projectId   String?
  project     BaProject?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  value       String
  description String?              @db.Text
  templateId  String?
  template    BaTemplate?          @relation(fields: [templateId], references: [id])
  isArchived  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([category, scope, projectId, name])
  @@index([category, scope])
  @@map("ba_master_data_entries")
}

model BaTemplate {
  id               String              @id @default(uuid())
  category         BaMasterDataCategory
  name             String
  version          Int                 @default(1)
  parentTemplateId String?
  parent           BaTemplate?         @relation("TemplateLineage", fields: [parentTemplateId], references: [id])
  children         BaTemplate[]        @relation("TemplateLineage")
  lastModifiedBy   BaTemplateModifier  @default(HUMAN)
  scope            BaMasterDataScope   @default(PROJECT)
  projectId        String?
  project          BaProject?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content          String              @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  masterDataEntries BaMasterDataEntry[]

  @@index([category, scope])
  @@map("ba_templates")
}

// ─── v4: LLD Configuration + Pseudo-code files ───────────────────────────────

model BaLldConfig {
  id                 String    @id @default(uuid())
  moduleDbId         String    @unique
  module             BaModule  @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  // Tech stack single-select FKs (null = skip, use AI best practices)
  frontendStackId    String?
  backendStackId     String?
  databaseId         String?
  streamingId        String?
  cachingId          String?
  storageId          String?
  cloudId            String?
  architectureId     String?
  cloudServices      String?   @db.Text
  // Template single-select FKs (null until Architect uploads)
  projectStructureId String?
  backendTemplateId  String?
  frontendTemplateId String?
  lldTemplateId      String?
  codingGuidelinesId String?
  // NFR values + free-form notes
  nfrValues          Json?
  customNotes        String?   @db.Text
  // Narrative-driven LLD (additive — null = use existing stack/template-only flow)
  narrative          String?   @db.Text
  useAsAdditional    Boolean   @default(true)
  attachments        BaLldConfigAttachment[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("ba_lld_configs")
}

// Architect attachments supplied alongside narrative. File bytes live on the
// configured storage backend (disk by default, S3/GCS via env). Only metadata
// + the extracted text live in Postgres.
model BaLldConfigAttachment {
  id              String       @id @default(uuid())
  lldConfigId     String
  lldConfig       BaLldConfig  @relation(fields: [lldConfigId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageBackend  String       // "disk" | "s3" | "gcs"
  storageKey      String       // path/key within the backend
  extractedText   String?      @db.Text
  extractionNote  String?      // why extraction failed, if applicable
  createdAt       DateTime     @default(now())

  @@index([lldConfigId])
  @@map("ba_lld_config_attachments")
}

model BaPseudoFile {
  id              String     @id @default(uuid())
  artifactDbId    String
  artifact        BaArtifact @relation(fields: [artifactDbId], references: [id], onDelete: Cascade)
  path            String
  language        String
  aiContent       String     @db.Text
  editedContent   String?    @db.Text
  isHumanModified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([artifactDbId, path])
  @@index([artifactDbId])
  @@map("ba_pseudo_files")
}

// ─── v4.2: FTC Configuration + Test Cases + Attachments ─────────────────────

model BaFtcConfig {
  id                   String    @id @default(uuid())
  moduleDbId           String    @unique
  module               BaModule  @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  // Test framework — multi-select. Architect can pick several and the skill
  // routes per-TC hints by category (UI→Playwright/Cypress, backend→pytest/JUnit,
  // perf→k6/JMeter, integration→REST-assured/Postman, etc.).
  testingFrameworks    String[]  @default([])
  // Coverage depth — single value. Smoke ⊂ Regression ⊂ Full.
  coverageTarget       String?   // Smoke | Regression | Full
  // Test types — multi-select. Filters which TC categories the skill emits.
  // Empty array = fall back to "all types" (matches pre-multiselect behaviour).
  testTypes            String[]  @default([])
  // OWASP preferences (MVP: Web Top 10 + LLM Top 10)
  owaspWebEnabled      Boolean   @default(true)
  owaspLlmEnabled      Boolean   @default(true)
  excludedOwaspWeb     String[]  @default([])  // e.g. ["A10"]
  excludedOwaspLlm     String[]  @default([])  // e.g. ["LLM08"]
  // When true and an LLD artifact exists for the module, generate white-box TCs
  includeLldReferences Boolean   @default(true)
  // FTC template — optional uploaded structural template (master data entry id)
  ftcTemplateId        String?
  // Free-form tester/architect notes (beyond the narrative field)
  customNotes          String?   @db.Text
  // Narrative-driven FTC (mirrors LLD narrative flow — additive)
  narrative            String?   @db.Text
  useAsAdditional      Boolean   @default(true)
  attachments          BaFtcConfigAttachment[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("ba_ftc_configs")
}

model BaFtcConfigAttachment {
  id              String       @id @default(uuid())
  ftcConfigId     String
  ftcConfig       BaFtcConfig  @relation(fields: [ftcConfigId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageBackend  String
  storageKey      String
  extractedText   String?      @db.Text
  extractionNote  String?
  createdAt       DateTime     @default(now())

  @@index([ftcConfigId])
  @@map("ba_ftc_config_attachments")
}

// Individual functional test case produced by SKILL-07-FTC. Parallel to
// BaPseudoFile but with structured fields suited to FTC: steps, expected,
// SQL setup/verify, OWASP tags, integration flag, playwright hints, and
// many-to-many traceability to features / stories / subtasks / pseudo files.
model BaTestCase {
  id                   String     @id @default(uuid())
  artifactDbId         String
  artifact             BaArtifact @relation(fields: [artifactDbId], references: [id], onDelete: Cascade)
  testCaseId           String     // human-readable: TC-001, Neg_TC-005, TC-001-INT-01
  title                String
  category             String?    // Functional | Integration | Security | Data | UI | Performance | ...
  scope                String     @default("black_box") // black_box | white_box
  testKind             String     @default("positive")  // positive | negative | edge
  priority             String?    // P0 | P1 | P2
  // Sprint & execution tracking — sprintId + executionStatus populated in v2;
  // schema columns reserved now so CSV export + future UI don't need another migration.
  // v4.4 B1: `sprintDbId` is the real FK; `sprintId` string remains for backward compat.
  sprintId             String?
  sprintDbId           String?
  sprint               BaSprint?  @relation(fields: [sprintDbId], references: [id], onDelete: SetNull)
  executionStatus      String     @default("NOT_RUN") // NOT_RUN | PASS | FAIL | BLOCKED | SKIPPED
  lastRunAt            DateTime?
  lastRunBy            String?
  defectIds            String[]   @default([]) // JIRA / Linear / GitHub issue refs
  // Scenario grouping (matches the CSV "Signup (Starter) Positive Tc" / "Negative Tc" pattern)
  scenarioGroup        String?    // e.g. "Signup – Starter Plan"
  testData             String?    @db.Text // concrete inputs: emails, phone numbers, card details, …
  e2eFlow              String?    // arrow-summary: "Launch URL → Signup → Submit → Success"
  preconditions        String?    @db.Text
  steps                String     @db.Text // markdown-formatted numbered steps
  expected             String     @db.Text // step-level expected outcome
  postValidation       String?    @db.Text // cross-cutting post-checks (email received, audit row, DB state)
  supportingDocs       String[]   @default([]) // screenshot / doc / trace names referenced by the TC
  // SQL helpers. Dialect comes from BaProject.sqlDialect.
  sqlSetup             String?    @db.Text // run before the test (insert fixtures, create tenant, …)
  sqlVerify            String?    @db.Text // run after the test (assert row state, audit entries, …)
  // Integration sub-test flag — these carry a parent testCaseId like TC-001
  isIntegrationTest    Boolean    @default(false)
  parentTestCaseId     String?    // the parent TC this integration case belongs to
  // OWASP tags (web A01-A10 or LLM LLM01-LLM10, null when not applicable)
  owaspCategory        String?
  // Playwright automation hints (selectors + actions + assertions). Plain text
  // for MVP; v2 may render these into runnable .spec.ts.
  playwrightHint       String?    @db.Text
  // Hints for the future v5.1 TDD codegen skill (what unit-level assertions
  // this functional case implies). Plain text; codegen parses later.
  developerHints       String?    @db.Text
  // Many-to-many traceability via opaque id arrays. IDs come from BaArtifact
  // parse time (FRD feature ids, EPIC ids, story ids, subtask ids, pseudo file ids).
  linkedFeatureIds     String[]   @default([])
  linkedEpicIds        String[]   @default([])
  linkedStoryIds       String[]   @default([])
  linkedSubtaskIds     String[]   @default([])
  linkedPseudoFileIds  String[]   @default([])
  // E2E-Flow (Track R) — structured links to cross-module journeys + steps.
  // The legacy free-text `e2eFlow` field above is retained for back-compat.
  linkedE2eFlowIds     String[]   @default([])  // BaE2eFlow.id values
  linkedE2eStepIds     String[]   @default([])  // BaE2eFlowStep.stepId values
  linkedLldArtifactId  String?    // when the TC is white-box, which LLD it references
  tags                 String[]   @default([])
  // Raw AI output for this TC (before any human edits), and the edited copy
  aiContent            String     @db.Text
  editedContent        String?    @db.Text
  isHumanModified      Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // v4.4 Phase 2a — denormalized latest-run FK for fast RTM/status queries.
  // Updated by BaTestRunService whenever a new run is recorded.
  latestRunId          String?

  runs                 BaTestRun[]
  defects              BaDefect[]

  @@unique([artifactDbId, testCaseId])
  @@index([artifactDbId])
  @@index([parentTestCaseId])
  @@map("ba_test_cases")
}

// ─── Phase 2a — Execution tracking + defects + RCA dual-track ──────────────

// One row per execution of a test case. Multiple runs per TC across time /
// sprints; `BaTestCase.latestRunId` caches the newest non-deleted one for
// fast status queries.
model BaTestRun {
  id           String      @id @default(uuid())
  testCaseId   String
  testCase     BaTestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  // v4.4 B1: `sprintDbId` is the real FK; `sprintId` string remains for backward compat.
  sprintId     String?     // legacy free-text (e.g. "Sprint 23"); prefer sprintDbId
  sprintDbId   String?
  sprint       BaSprint?   @relation(fields: [sprintDbId], references: [id], onDelete: SetNull)
  executor     String?
  executedAt   DateTime    @default(now())
  status       String      // PASS | FAIL | BLOCKED | SKIPPED
  notes        String?     @db.Text
  durationSec  Int?
  environment  String?     // staging / prod / uat / custom
  deletedAt   DateTime?   // soft-delete
  defects     BaDefect[]  @relation("DefectFirstSeenInRun")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([testCaseId, executedAt])
  @@index([testCaseId, deletedAt])
  @@map("ba_test_runs")
}

// Defects raised from failed runs. externalRef points at the authoritative
// tracker (JIRA / Linear / GitHub issue); our internal fields capture the
// tester's immediate notes. Status + severity enforce a light workflow.
model BaDefect {
  id                String               @id @default(uuid())
  testCaseId        String
  testCase          BaTestCase           @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  firstSeenRunId    String?
  firstSeenRun      BaTestRun?           @relation("DefectFirstSeenInRun", fields: [firstSeenRunId], references: [id], onDelete: SetNull)
  externalRef       String?              // JIRA / Linear / GitHub issue URL
  title             String
  description       String?              @db.Text
  severity          String               @default("P2") // P0 | P1 | P2 | P3
  status            String               @default("OPEN") // OPEN | IN_PROGRESS | FIXED | VERIFIED | CLOSED | WONT_FIX
  reproductionSteps String?              @db.Text
  environment       String?
  reportedBy        String?
  reportedAt        DateTime             @default(now())
  closedAt          DateTime?
  attachments       BaDefectAttachment[]
  rcas              BaRca[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([testCaseId, status])
  @@index([firstSeenRunId])
  @@map("ba_defects")
}

// Defect evidence. Reuses the same pluggable `AttachmentStorage` used by
// LLD + FTC narrative attachments — only metadata + optional extracted
// text live in Postgres.
model BaDefectAttachment {
  id              String   @id @default(uuid())
  defectId        String
  defect          BaDefect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageBackend  String
  storageKey      String
  extractedText   String?  @db.Text
  extractionNote  String?
  createdAt       DateTime @default(now())

  @@index([defectId])
  @@map("ba_defect_attachments")
}

// Dual-track Root Cause Analysis per defect. Multiple rows allowed so
// revisions of either track are preserved (e.g. tester rejects AI's
// hypothesis and writes their own; both stay on record).
model BaRca {
  id                  String   @id @default(uuid())
  defectId            String
  defect              BaDefect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  source              String   // AI | TESTER
  rootCause           String   @db.Text
  contributingFactors String[] @default([])
  proposedFix         String?  @db.Text
  confidence          Float?   // 0.0 – 1.0 for AI; null for TESTER
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([defectId, source])
  @@map("ba_rcas")
}

// AC Coverage Verification — one row per acceptance criterion from an upstream
// artifact (EPIC / User Story / SubTask), marked as covered / uncovered /
// partial by the FTC. Generated at skill time (via SKILL-07 output section)
// and re-generable via a standalone post-gen analysis endpoint.
model BaAcCoverage {
  id                 String     @id @default(uuid())
  artifactDbId       String
  artifact           BaArtifact @relation(fields: [artifactDbId], references: [id], onDelete: Cascade)
  acSource           String     // e.g. "US-001 AC#3" or "ST-US001-BE-03 DoD#2"
  acSourceType       String     // EPIC | USER_STORY | SUBTASK | FEATURE
  acText             String     @db.Text
  coveringTcIds      String[]   @default([]) // BaTestCase.id values
  coveringTcRefs     String[]   @default([]) // human-readable TC-001, Neg_TC-002
  status             String     // COVERED | UNCOVERED | PARTIAL
  rationale          String?    @db.Text // AI explanation of the match / gap
  analyzedAt         DateTime   @default(now())
  source             String     // AI_SKILL (from generation) | POST_GEN_CHECK (re-analysis)

  @@index([artifactDbId])
  @@index([artifactDbId, status])
  @@map("ba_ac_coverage")
}

// ─── Discovery & Solutioning Track ───────────────────────────────────────────
// Project-level pipeline: Audio → WFT → BRD → Approach Note → Lo-fi → Hi-fi.
// Stage 1 (this slice): BaAudioFile + BaWft. Subsequent slices add BaBrd,
// BaApproachNote(+Version), BaWireframeSet(+Screen), BaHifiSet(+Screen),
// plus extensions to BaModule and BaArtifact for EPIC context.
// Designed per BRD-discovery-track.md and Approach-Note-discovery-track-v1.md.

enum BaAudioFileStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

model BaAudioFile {
  id             String            @id @default(uuid())
  projectId      String
  project        BaProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  sizeBytes      Int
  durationSec    Int?
  fileData       String            @db.Text   // base64 (Phase 1: DB; Phase 2: S3 URL)
  rawTranscript  String?           @db.Text
  detectedLang   String?
  sttProvider    String?
  status         BaAudioFileStatus @default(UPLOADED)
  errorMessage   String?           @db.Text
  retentionUntil DateTime?         // 90-day default per BRD §6 FR-15; null = retain indefinitely
  uploadedById   String?
  // Optional FK to the WFT this audio was rolled up into (set after WFT generation).
  wftId          String?
  wft            BaWft?            @relation(fields: [wftId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId, createdAt])
  @@index([wftId])
  @@map("ba_audio_files")
}

enum BaWftStatus {
  DRAFT
  COMPLETE
  APPROVED
}

model BaWft {
  id            String       @id @default(uuid())
  projectId     String
  project       BaProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 7-section WFT per skill 01:
  // §1 raw transcript · §2 cleaned · §3 paraphrased meaning ·
  // §4 key concepts & entities · §5 action items · §6 open questions · §7 metadata
  rawTranscript String       @db.Text   // §1 — concatenated from source audio files
  cleanedText   String?      @db.Text   // §2 — disfluencies removed
  paraphrased   String?      @db.Text   // §3 — third-person prose
  concepts      Json?        // §4 — [{name, context}]
  actionItems   Json?        // §5 — string[]
  openQuestions Json?        // §6 — string[]
  meta          Json?        // §7 — {language, domainContext, model, ...}
  status        BaWftStatus  @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  audioFiles    BaAudioFile[]
  brds          BaBrd[]

  @@index([projectId, createdAt])
  @@map("ba_wfts")
}

enum BaBrdStatus {
  DRAFT
  COMPLETE
  APPROVED
}

model BaBrd {
  id            String       @id @default(uuid())
  projectId     String
  project       BaProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wftId         String
  wft           BaWft        @relation(fields: [wftId], references: [id], onDelete: Cascade)
  // 15-section BRD per skill 02. Phase 1 stores as overwrite-on-regenerate;
  // Phase 2 introduces append-only versioning per BRD §1.1 (skill 02 §4.1).
  sections      Json         // { "1": "markdown body", "2": "...", ... }
  frTable       Json?        // [{ id: "FR-1", requirement: "...", testable: bool }]
  openItems     Json?        // string[] — items captured in §15
  meta          Json?        // { audience, model, generatedAt, productName, ... }
  status        BaBrdStatus  @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([wftId])
  @@map("ba_brds")

  approachNotes BaApproachNote[]
}

model BaApproachNote {
  id               String                  @id @default(uuid())
  projectId        String
  project          BaProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brdId            String
  brd              BaBrd                   @relation(fields: [brdId], references: [id], onDelete: Cascade)
  /// FK to the latest version (denormalized pointer; updated on each new-version creation).
  currentVersionId String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  versions         BaApproachNoteVersion[]

  @@index([projectId, createdAt])
  @@index([brdId])
  @@map("ba_approach_notes")
}

enum BaApproachNoteVersionStatus {
  DRAFT
  REVIEW
  APPROVED
}

model BaApproachNoteVersion {
  id               String                       @id @default(uuid())
  approachNoteId   String
  approachNote     BaApproachNote               @relation(fields: [approachNoteId], references: [id], onDelete: Cascade)
  versionNumber    Int                          // 1, 2, 3 ...
  /// 12-section AN per skill 03. Free-form markdown bodies keyed by section number ("1".."12").
  sections         Json                         // { "1": "## 1. Executive Verdict ...", ..., "12": "## 12. PRD-Readiness Bridge ..." }
  /// End-user-supplied brand tokens (per skill 03 §3.10). Cascades to lo-fi + hi-fi in later stages.
  brandTokens      Json?                        // { primary, surface, cta, logo, productName, ... }
  /// Closed-by-stakeholder decisions parsed from §8.1.
  decisionsLocked  Json?                        // [{ question, decision }]
  /// Surfaced ambiguities from §8.3 — every silent default surfaced.
  openQuestions    Json?                        // [{ number, question, default }]
  /// §12 PRD-Readiness Bridge — structured form of items the PRD generator lifts directly.
  /// Mirrors the §12 markdown narrative in `sections["12"]`. See skill 03 §12.
  prdReadiness     Json?                        // { actors, integrations, customerJourneys, functionalLandscape, uiUxRequirements, complianceRequirements, testingRequirements, keyDeliverables, receivables, environmentList, miscellaneous }
  /// Append-only changelog. Required v2+, null on v1.
  changesSince     String?                      @db.Text
  /// FK to prior version this one supersedes; null on v1.
  supersedesId     String?
  meta             Json?                        // { audience, model, generatedAt, ... }
  status           BaApproachNoteVersionStatus  @default(DRAFT)
  generatedAt      DateTime                     @default(now())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([approachNoteId, versionNumber])
  @@index([approachNoteId])
  @@map("ba_approach_note_versions")

  wireframeSets BaWireframeSet[]
}

enum BaWireframeSetStatus {
  DRAFT
  COMPLETE
  APPROVED
}

model BaWireframeSet {
  id                    String                @id @default(uuid())
  projectId             String
  project               BaProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // v8 (Z-01): nullable so PIPELINE (PRD-sourced) + uploaded sets need no Approach Note.
  approachNoteVersionId String?
  approachNoteVersion   BaApproachNoteVersion? @relation(fields: [approachNoteVersionId], references: [id], onDelete: Cascade)
  // v8 — DISCOVERY (BRD/Approach-Note) vs PIPELINE (PRD-sourced via screen map).
  source                String                @default("DISCOVERY")
  // When source=PIPELINE: the BaScreenMap this set was generated/uploaded against.
  screenMapId           String?
  // v9 (DD-02): the BaDesignSystem whose tokens styled this set.
  designSystemId        String?
  // { prdVersion, screenMapVersion, designSystemVersion } — drives v8/v9 freshness.
  sourceArtifactVersions Json?
  /// Snapshot of brand tokens at generation time — auditable cascade per skill 04 §4.6.
  brandTokensSnapshot   Json
  /// { validated: bool, orphanFrs: string[], orphanScreens: number[], issues: [...] }
  coverageStatus        Json?
  /// { audience, model, generatedAt, screenCount, ... }
  meta                  Json?
  status                BaWireframeSetStatus  @default(DRAFT)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  screens               BaWireframeScreen[]
  hifiSets              BaHifiSet[]

  @@index([projectId, createdAt])
  @@index([approachNoteVersionId])
  @@map("ba_wireframe_sets")
}

model BaWireframeScreen {
  id          String         @id @default(uuid())
  setId       String
  set         BaWireframeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  sequenceNum Int            // 1..N display order
  slug        String         // "landing", "main-chat", "customer-list", ...
  title       String         // human-readable screen name
  /// Skill 04 §4 pattern reference, e.g. "§4.1 Landing", "§4.2 Conversational chat".
  pattern     String?
  /// [{ n: number|string, description: string, mappedTo: string }]
  callouts    Json
  /// [{ file: string, purpose: string }] — references AN §3.12.5 frontend folder structure
  components  Json?
  /// Markdown source per skill 04 §5.2 — the canonical readable artefact.
  mdContent   String?        @db.Text
  /// HTML rendering per skill 04 §5.3 — sandboxed iframe-renderable.
  htmlContent String?        @db.Text
  /// { frRefs: string[], generationOrder: number, ... }
  meta        Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([setId, sequenceNum])
  @@index([setId])
  @@map("ba_wireframe_screens")
}

enum BaHifiSetStatus {
  DRAFT
  COMPLETE
  APPROVED
}

model BaHifiSet {
  id               String              @id @default(uuid())
  projectId        String
  project          BaProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wireframeSetId   String
  wireframeSet     BaWireframeSet      @relation(fields: [wireframeSetId], references: [id], onDelete: Cascade)
  /// Brand tokens snapshot at hi-fi generation time (typically same as the lo-fi parent's,
  /// but captured separately so brand changes between Stage 4 and Stage 5 are auditable).
  brandTokensSnapshot Json
  /// Synthetic seed data shared across all hi-fi screens for demo coherence
  /// (per skill 05 §3 — same Mr Sharma everywhere).
  syntheticDataSeed Json?
  /// Per-set parity check vs the lo-fi parent — { validated: bool, mismatches: [...] }
  parityStatus     Json?
  /// { audience, model, generatedAt, screenCount, ... }
  meta             Json?
  status           BaHifiSetStatus     @default(DRAFT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  screens          BaHifiScreen[]

  @@index([projectId, createdAt])
  @@index([wireframeSetId])
  @@map("ba_hifi_sets")
}

model BaHifiScreen {
  id          String     @id @default(uuid())
  setId       String
  set         BaHifiSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  sequenceNum Int        // Mirrors the lo-fi sequenceNum 1:1 (same screen order)
  slug        String
  title       String
  /// Polished branded HTML per skill 05 §5.2 — sandboxed iframe-renderable.
  htmlContent String     @db.Text
  /// Callouts MUST equal the lo-fi parent's 1:1 (skill 05 §7 invariant).
  /// Hi-fi-only annotations use letter suffixes (e.g. "3a") — never renumber existing.
  callouts    Json
  /// Per-screen parity status — { validated: bool, mismatches: [...] }
  parityStatus Json?
  meta        Json?      // { loFiScreenId, frRefs: string[], ... }
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([setId, sequenceNum])
  @@index([setId])
  @@map("ba_hifi_screens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW PIPELINE — Customer Discovery → PRD+FRD → Wireframes → HLD → EPICs → Code
// All models below are additive — no existing model or migration is touched.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Customer Input Hub (Stage 1) ────────────────────────────────────────────
// Polymorphic container for any customer-supplied input.
// New input types are added by extending the enum — no schema migration needed
// for the table itself beyond adding the enum value.

enum BaCustomerInputType {
  AUDIO              // audio recording; STT delegated to existing pipeline
  EXTERNAL_BRD       // customer's own BRD document
  CUSTOMER_WIREFRAME // customer's own mockup or sketch (image)
  TEXT_CONTEXT       // free text / requirements notes
  DOCUMENT           // any other supporting document (PDF / DOCX / TXT)
}

model BaCustomerInput {
  id            String              @id @default(uuid())
  projectId     String
  project       BaProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inputType     BaCustomerInputType
  label         String              // user-defined name, e.g. "Competitor App Screenshots"
  fileData      String?             @db.Text  // base64-encoded file content
  fileMetadata  Json?               // { fileName, mimeType, fileSize, pageCount }
  extractedText String?             @db.Text  // text extracted from uploaded document
  metadata      Json                @default("{}")  // type-specific extra data
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([projectId])
  @@index([projectId, inputType])
  @@map("ba_customer_inputs")
}

// ─── Combined PRD + FRD (Stage 2) ─────────────────────────────────────────────
// Project-level PRD generated from all customer inputs.
// FRD is embedded under section key "functionalRequirements".
// Section schema: { [sectionKey]: { aiContent, editedContent, lockedAt } }

model BaProjectPrd {
  id             String           @id @default(uuid())
  projectId      String
  project        BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int              @default(1)
  status         BaArtifactStatus @default(DRAFT)
  // Section keys (22 PRD sections; FRD embedded in "functionalRequirements"):
  // productOverview | problemStatement | objectives | scope | assumptions |
  // userPersonas | functionalRequirements (contains FRD) | nonFunctionalRequirements |
  // systemIntegrations | dataRequirements | securityRequirements | uxRequirements |
  // performanceRequirements | complianceRequirements | risksMitigations |
  // successMetrics | releaseStrategy | glossary | openItems | appendix |
  // changeHistory | signOff
  sections       Json             @default("{}")
  changesSince   String?          @db.Text
  // IDs of BaCustomerInput records used as context for this generation
  sourceInputIds String[]
  // ── CR Foundation (Track M — traceability fields, nullable, no UI yet) ──
  triggeredBy            BaTriggeredBy? @default(INITIAL_GENERATION)
  changeRequestId        String?
  sourceArtifactVersions Json?
  // ── Interactive authoring + forward propagation (Track S/T — v6) ──
  // metadata.gaps:       [{ section, question }]                  — persisted AI gaps
  // metadata.gapAnswers: [{ section, question, answer, answeredAt }] — audit trail
  // metadata.freshness:  { computedAt, downstream:[{ artifactType, id, builtFrom, current, stale, reason }] }
  // metadata.review:     Record<sectionKey, 'pending'|'accepted'|'edited'|'skipped'>  — draft-review gate (v7 W-01)
  // metadata.restoredFrom: <version>  — set when this version was cloned from an older one (v7 W-02)
  metadata       Json             @default("{}")
  // ── PRD-level metadata (v7 W-02) — nullable; client/submittedBy inherit from BaProject when null ──
  prdCode        String?
  clientName     String?
  submittedBy    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, version])
  @@index([changeRequestId])
  @@map("ba_project_prds")
}

// ─── High Level Design / HLD (Stage 5) ─────────────────────────────────────────
// Template derived from HRMS HLD v2.1 (63 pages, 17 sections, 4 architecture views).
// Section schema: { [sectionKey]: { aiContent, editedContent, lockedAt } }
// Mermaid diagrams schema: { [diagramKey]: mermaidSyntaxString }

model BaHld {
  id              String           @id @default(uuid())
  projectId       String
  project         BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int              @default(1)
  status          BaArtifactStatus @default(DRAFT)
  // 17 section keys (from HRMS HLD v2.1 template):
  // documentControl | executiveSummary | systemView | technicalLayersView |
  // componentView | architectureStyleView | deploymentView |
  // architectureStyleDecision | technologyStack | designPatterns |
  // authDesign | aiLayer | integrations | multiTenancy |
  // nfr | prdCoverage | projectStructure
  sections        Json             @default("{}")
  // Mermaid diagrams for the 4 architecture views + deployment:
  // systemView | technicalLayers | componentView | architectureStyle | deployment
  mermaidDiagrams Json             @default("{}")
  changesSince    String?          @db.Text
  // ── CR Foundation (Track M — traceability fields, nullable, no UI yet) ──
  triggeredBy            BaTriggeredBy? @default(INITIAL_GENERATION)
  changeRequestId        String?
  sourceArtifactVersions Json?
  // ── Forward propagation (Track S/T — v6): mirrors BaProjectPrd.metadata ──
  // metadata.gaps · metadata.freshness — gaps + downstream staleness symmetry
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, version])
  @@index([changeRequestId])
  @@map("ba_hlds")
}

// ─── Screen ↔ Feature Mapping (Stage 3a — Wireframes, Sprint v8 / Track Y) ──────
// PRD-sourced screen map: each row maps a screen to §6 FR-IDs + PRD sections +
// business rules + numbered annotations, all referencing the PRD (not BRD/AN).
// Drives lo-fi/hi-fi wireframe generation (BaWireframeSet source=PIPELINE).

model BaScreenMap {
  id                     String           @id @default(uuid())
  projectId              String
  project                BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version                Int              @default(1)
  status                 BaArtifactStatus @default(DRAFT)
  // { prdVersion } — drives v8 freshness (PRD → screen-map → wireframes → HLD)
  sourceArtifactVersions Json?
  triggeredBy            BaTriggeredBy?   @default(INITIAL_GENERATION)
  // { coverage: { orphanFrs: string[], orphanScreens: string[] } }
  metadata               Json             @default("{}")
  rows                   BaScreenMapRow[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, version])
  @@map("ba_screen_maps")
}

model BaScreenMapRow {
  id                     String      @id @default(uuid())
  screenMapId            String
  screenMap              BaScreenMap @relation(fields: [screenMapId], references: [id], onDelete: Cascade)
  screenId               String      // "SCR-01"
  sequenceNum            Int
  screenName             String
  prdSections            String[]    // PRD section refs, e.g. "§6", "§10"
  featureRefs            String[]    // §6 FR-IDs, e.g. "FR-AUTH-001"
  featureDescription     String      @db.Text
  businessRulesPrd       String      @db.Text
  businessRulesArchitect String      @db.Text
  screenDescription      String      @db.Text   // the "EPIC" screen description
  // [{ marker: "P" | number, title, description, prdRef }] — PRD-referenced annotations
  annotations            Json
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([screenMapId, sequenceNum])
  @@index([screenMapId])
  @@map("ba_screen_map_rows")
}

// ── Design System / "Look & Feel" Studio (Sprint v9 · Track AA) ──────────────
// Per-project active design tokens (+ logo) defined before lo-fi wireframes.
// Tokens formalize the existing brandTokensSnapshot shape and flow into lo-fi,
// hi-fi, and the wireframe navigator via a shared tokensToCss() util.

model BaDesignSystem {
  id                     String           @id @default(uuid())
  projectId              String
  project                BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version                Int              @default(1)
  status                 BaArtifactStatus @default(DRAFT)
  // DesignTokens: { brand, neutral, semantic, modulePalette, personaPalette, typography, shape, platform }
  tokens                 Json
  // { dataUri, fileName, mimeType, width, height } — uploaded brand logo
  logo                   Json?
  // Provenance: the preset this system started from (nullable)
  presetId               String?
  // { prdVersion, screenMapVersion } — drives v9 freshness
  sourceArtifactVersions Json?
  metadata               Json             @default("{}")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, version])
  @@map("ba_design_systems")
}

// Reusable template library. scope=GLOBAL presets are shared across projects;
// scope=PROJECT presets belong to one project. isSeed marks shipped starters.
model BaDesignPreset {
  id          String     @id @default(uuid())
  name        String
  scope       String     @default("GLOBAL") // "GLOBAL" | "PROJECT"
  projectId   String?
  project     BaProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokens      Json       // DesignTokens
  thumbnail   String?    @db.Text           // inline SVG/HTML or data-URI preview
  isSeed      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([scope])
  @@index([projectId])
  @@map("ba_design_presets")
}

// ─── Project Implementation Folder (Stage 8) ────────────────────────────────
// Tracks the on-disk ProjectImplementation/ folder created from LLD structure.
// One record per project; created when LLD is first confirmed.

enum BaScaffoldStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  ERROR
}

enum BaContextStatus {
  PENDING
  GENERATING
  COMPLETE
  ERROR
}

model BaProjectImplementation {
  id                       String           @id @default(uuid())
  projectId                String           @unique
  project                  BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderPath               String           // absolute path: Projects/{code}/ProjectImplementation/
  scaffoldStatus           BaScaffoldStatus @default(PENDING)
  contextEngineeringStatus BaContextStatus  @default(PENDING)
  lldSyncedAt              DateTime?        // last time LLD was synced to/from code on disk
  lastContextRefreshedAt   DateTime?        // last time .context/ markdown files were regenerated
  // { lastError, filesPlaced, totalFiles, lldModuleId, pseudoFilesPlaced,
  //   sourceCodeHashes: { "<path>": "<sha256>" }, lastSyncAt, ... }
  metadata                 Json             @default("{}")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@map("ba_project_implementations")
}

// ─── Code Task (Track O) — the /prd-generated, /dev-executed task plan ───────
// One row per implementation task for a module. Ordered by the topological sort
// of the subtask prerequisite graph; each task links the subtask(s) and pseudo
// file(s) it implements so the UI can trace task → subtask → pseudo file.

enum BaCodeTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model BaCodeTask {
  id             String           @id @default(uuid())
  moduleDbId     String
  module         BaModule         @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  projectId      String           // denormalized for project-wide task views
  sequence       Int              // execution order (topo-sort of subtask prerequisites)
  taskKey        String           // e.g. TASK-MOD-02-01
  title          String
  description    String?          @db.Text
  status         BaCodeTaskStatus @default(PENDING)
  // ── Linkage (O-02): what this task implements ──
  subtaskRefs    String[]         // BaSubTask.subtaskId values
  pseudoFileRefs String[]         // BaPseudoFile.path values
  targetFiles    String[]         // source files this task creates/edits
  // ── Execution bookkeeping (P-01) ──
  runId          String?          // the /dev run that executed it
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?          @db.Text
  generatedFiles Json?            // files actually written (P-01); feeds P-04 dynamic detection
  // P-04 — created during /dev because the file wasn't in the LLD/subtasks.
  isDynamic      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([moduleDbId, taskKey])
  @@index([moduleDbId, sequence])
  @@index([projectId])
  @@map("ba_code_tasks")
}

// ─── Code Test Run (Track P/Q) — two-tier code-gen test results + history ────
// NOTE: named BaCodeTestRun (table ba_code_test_runs) to avoid colliding with
// the existing BaTestRun / ba_test_runs (test-case execution tracking, above).
// kind=DEV  → tests generated/run by /dev during code-gen (Stage 1)
// kind=FTC  → Playwright tests derived from the module's FTC cases (Stage 2)
// One row per execution; history = all rows for a module, newest first.

enum BaCodeTestRunKind {
  DEV
  FTC
}

enum BaCodeTestRunStatus {
  RUNNING
  PASSED
  FAILED
  ERROR
}

model BaCodeTestRun {
  id               String              @id @default(uuid())
  moduleDbId       String
  module           BaModule            @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  projectId        String
  kind             BaCodeTestRunKind
  framework        String              // playwright | jest | vitest | pytest | …
  status           BaCodeTestRunStatus @default(RUNNING)
  total            Int                 @default(0)
  passed           Int                 @default(0)
  failed           Int                 @default(0)
  skipped          Int                 @default(0)
  durationMs       Int?
  command          String?             // the command that was executed
  output           String?             @db.Text   // captured stdout/stderr (truncated)
  artifacts        Json?               // { screenshots:[], videos:[], traces:[], reportPath }
  reportPath       String?
  triggeredByRunId String?             // the /dev or test run that produced this
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([moduleDbId, kind, createdAt])
  @@index([projectId])
  @@map("ba_code_test_runs")
}

// ─── Upstream Sync (Track P-04/P-05 + J) — downstream→upstream auto-drafts ────
// When /dev creates a file not in the LLD/subtasks (a "dynamic file"), an
// auto-draft is staged here for human approval. On approval the draft is applied
// upstream (LLD pseudo-file + subtask + CHANGELOG + RTM). Never auto-applies.

enum BaUpstreamSyncStatus {
  PENDING
  APPROVED
  REJECTED
}

model BaUpstreamSync {
  id               String               @id @default(uuid())
  moduleDbId       String
  module           BaModule             @relation(fields: [moduleDbId], references: [id], onDelete: Cascade)
  projectId        String
  status           BaUpstreamSyncStatus @default(PENDING)
  trigger          String               // DYNAMIC_FILE | CODE_EDIT
  filePath         String?              // the new/changed source file
  summary          String               @db.Text   // human-readable proposed change
  proposedLld      String?              @db.Text   // draft LLD note for the new file
  proposedSubtask  Json?                // draft subtask fields
  changelogEntry   String?              @db.Text   // CHANGELOG line to append on approve
  rtmRow           Json?                // draft RTM row
  triggeredByRunId String?
  resolvedAt       DateTime?
  resolvedNote     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([moduleDbId, status])
  @@index([projectId])
  @@map("ba_upstream_syncs")
}

// ─── E2E-Flow (Track R) — cross-module, role-based customer journeys ─────────
// Project-scoped (like BaHld), starts before EPICs, elaborates downstream.
// Strictly additive: nothing here changes existing module-scoped flows/tests.

// A graph node type for an E2E-flow step (full decision-graph branching).
enum BaE2eNodeType {
  START
  STEP
  DECISION
  JOIN
  END
}

model BaE2eFlow {
  id               String           @id @default(uuid())
  projectId        String
  project          BaProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flowKey          String           // e.g. E2E-CHECKOUT, E2E-FUND-TRANSFER
  flowName         String           // "Banking Fund Transfer"
  journeyType      String?          // UI | API | MIXED
  primaryRole      String?          // Customer | Admin | Guest | API-Client
  secondaryRoles   String[]         @default([])  // multi-actor (OTP issuer, ledger svc)
  status           BaArtifactStatus @default(DRAFT)
  spannedModuleIds String[]         @default([])  // BaModule.id values the flow crosses
  // 4 diagrams keyed: functional | classMethod | dbEntities | integrations
  mermaidDiagrams  Json             @default("{}")
  e2eArtifactId    String?          // soft-FK to the BaArtifact (type E2E_FLOW) holding sections
  // CR Foundation (Track M) traceability
  triggeredBy            BaTriggeredBy? @default(INITIAL_GENERATION)
  changeRequestId        String?
  sourceArtifactVersions Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  steps            BaE2eFlowStep[]

  @@unique([projectId, flowKey])
  @@index([projectId])
  @@index([changeRequestId])
  @@map("ba_e2e_flows")
}

model BaE2eFlowStep {
  id                      String        @id @default(uuid())
  e2eFlowId               String
  e2eFlow                 BaE2eFlow     @relation(fields: [e2eFlowId], references: [id], onDelete: Cascade)
  sequenceNum             Int           // display ordering hint
  stepId                  String        // e.g. S04 (stable step identity)
  nodeType                BaE2eNodeType @default(STEP)
  nextStepIds             String[]      @default([])  // graph edges → other stepId values
  branchLabels            Json?         // { "<nextStepId>": "OTP valid" } for DECISION nodes
  moduleDbId              String?       // cross-module context the old click-through lacked
  screenId                String?       // human-readable screen ref; null for pure-API steps
  role                    String?       // actor for this step
  triggerLabel            String?       // reused from click-through
  outcome                 String?       // reused from click-through
  condition               String?       // free-text guard (complements branchLabels)
  layer                   String?       // UI | API | DB | Integration
  thirdPartyIntegrationId String?       // soft-FK to BaThirdPartyIntegration
  // Optional custom screenshot for this step (base64 data-URI, like BaScreen).
  // When absent, the UI falls back to the referenced module screen's image (screenId).
  screenshotData          String?       @db.Text
  screenshotName          String?
  // Downstream elaboration store: keyed by stage (EPIC|USER_STORY|SUBTASK|LLD|FTC|WTC)
  // → { modules, features, classes, methods, dbEntities, integrations, testCaseRefs }.
  // Written immutably (read → new-copy → write), one stage key per skill.
  elaborationByStage      Json          @default("{}")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([e2eFlowId, stepId])
  @@index([e2eFlowId, sequenceNum])
  @@map("ba_e2e_flow_steps")
}

// Project-scoped config for the E2E-flow skill (mirrors BaFtcConfig).
model BaE2eFlowConfig {
  id                String                      @id @default(uuid())
  projectId         String                      @unique
  project           BaProject                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceJourneys String[]                    @default([])  // checkout, fund-transfer, ...
  defaultRoles      String[]                    @default([])
  coverageTarget    String?                     // Smoke | Regression | Full
  targetEnv         String?                     // staging | uat | prod-like
  baseUrl           String?
  narrative         String?                     @db.Text
  useAsAdditional   Boolean                     @default(true)
  attachments       BaE2eFlowConfigAttachment[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@map("ba_e2e_flow_configs")
}

model BaE2eFlowConfigAttachment {
  id              String          @id @default(uuid())
  configId        String
  config          BaE2eFlowConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageBackend  String
  storageKey      String
  extractedText   String?         @db.Text
  extractionNote  String?
  createdAt       DateTime        @default(now())

  @@index([configId])
  @@map("ba_e2e_flow_config_attachments")
}

// External integration registry (fills the gap TBD-Future doesn't: 3rd-party
// vendors). Powers the integrations Mermaid diagram + OTP/payment/email steps.
model BaThirdPartyIntegration {
  id               String    @id @default(uuid())
  projectId        String
  project          BaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorName       String    // Stripe, Twilio, SendGrid, Google OAuth
  category         String    // PAYMENT | SMS_OTP | EMAIL | AUTH | WEBHOOK | OTHER
  endpoint         String?
  authScheme       String?
  status           String?   // ASSUMED | CONFIRMED | STUBBED
  source           String?   // HLD | E2E_SKILL | MANUAL (auto-seeded from HLD, editable)
  mappedToFlowIds  String[]  @default([])  // BaE2eFlow.id values
  mappedToStepIds  String[]  @default([])  // BaE2eFlowStep.stepId values
  linkedSubtaskIds String[]  @default([])
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId])
  @@map("ba_third_party_integrations")
}

// ─── CR Foundation (Track M) — schema only, UI deferred ─────────────────────
// Designed now so artifact tables carry CR traceability from day one and the
// future Change Request feature ships without a disruptive migration.

// What caused an artifact version to be created. Used on BaArtifact,
// BaProjectPrd, BaHld so we can always answer "why does this version exist?".
enum BaTriggeredBy {
  INITIAL_GENERATION  // first generation from upstream inputs
  CHANGE_REQUEST      // produced by a customer Change Request
  DOWNSTREAM_SYNC     // produced by code→artifact sync (Track L sync agent)
  MANUAL_EDIT         // hand-edited by a user
}

enum BaChangeRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  IMPLEMENTED
  REJECTED
  CANCELLED
}

// The pipeline stage at which the CR was raised. A CR can arrive at ANY stage —
// before or after any artifact exists — so impact analysis must handle all.
enum BaChangeRequestStage {
  CUSTOMER_INPUTS
  PRD_FRD
  WIREFRAMES
  HLD
  EPICS
  USER_STORIES
  SUBTASKS
  LLD
  SOURCE_CODE
}

model BaChangeRequest {
  id          String                @id @default(uuid())
  projectId   String
  project     BaProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crCode      String                // human-readable: CR-001, CR-002
  title       String
  description String                @db.Text
  status      BaChangeRequestStatus @default(DRAFT)
  // Stage at which the customer raised the change.
  stage       BaChangeRequestStage
  changeType  String?               // "scope" | "ui" | "data" | "integration" | "policy" | ...
  priority    String                @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL
  requestedBy String?               // customer / stakeholder name
  // Artifact IDs this CR is expected to (or did) impact — populated by impact
  // analysis when the CR feature is fully built. Soft references.
  impactedArtifactIds String[]      @default([])
  // Free-form impact analysis + audit trail until the full CR UI lands.
  metadata    Json                  @default("{}")
  approvedBy  String?
  implementedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([projectId, crCode])
  @@index([projectId])
  @@index([projectId, status])
  @@map("ba_change_requests")
}

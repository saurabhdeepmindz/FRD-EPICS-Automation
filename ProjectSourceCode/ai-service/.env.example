# AI Service environment variables
# Copy to .env for local development — never commit .env

# OpenAI API key — place your key here (never commit the real key)
OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use
OPENAI_MODEL=gpt-4.5-preview

# Anthropic (Claude) — used for wireframe hi-fi generation
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Engine for /hifi-generate: "anthropic" (Claude) or "openai"
HIFI_PROVIDER=anthropic

# Service port
PORT=5000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:4000
